# Application
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite+aiosqlite:///./vn_banking.db

# Groq API (free at console.groq.com)
GROQ_API_KEY=your-groq-api-key

# Email via Brevo API (sign up free at https://brevo.com, 300 emails/day, send to anyone)
BREVO_API_KEY=your-brevo-api-key-here
EMAIL_FROM_NAME=VN Real Estate Intelligence
EMAIL_FROM_ADDRESS=your-verified-sender@gmail.com

# Crawl schedule (cron format, default: daily at 7am Vietnam time)
CRAWL_SCHEDULE_HOUR=7
CRAWL_SCHEDULE_MINUTE=0

# Notification schedule (daily at 8am Vietnam time)
NOTIFY_SCHEDULE_HOUR=8
NOTIFY_SCHEDULE_MINUTE=0

# CORS origins — add your Vercel URL when deployed (comma-separated)
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173,http://localhost:3000
